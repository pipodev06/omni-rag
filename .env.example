# =====================================================================
# Copia este archivo a `.env` y completa los valores marcados con  <-- CAMBIAR
#
#   cp .env.example .env
#
# OBLIGATORIAS (sin ellas no arranca o no funciona el chat):
#   POSTGRES_PASSWORD, APP_DB_PASSWORD, JWT_SECRET,
#   SEED_ADMIN_USERNAME, SEED_ADMIN_PASSWORD, OPENROUTER_API_KEY
# Todo lo demás tiene un valor por defecto razonable.
#
# Genera secretos aleatorios con:  openssl rand -base64 48
# (valen contraseñas con «/», «+» o «=»). No subas el `.env` a git.
#
# Tras editar el .env, aplica los cambios con:  docker compose up -d
# (`restart` NO relee el .env). Ver docs/operacion.md.
# =====================================================================

# --- Base de datos ----------------------------------------------------
# Solo se aplican al CREAR la base de datos. Cambiarlas después no cambia la
# contraseña guardada en la base (ver docs/operacion.md → «Cambiar contraseñas»).
# <-- CAMBIAR (usuario rag_owner; en producción, mínimo 16 caracteres)
POSTGRES_PASSWORD=cambia-esta-clave-del-owner
# <-- CAMBIAR (usuario rag_app, sujeto a RLS; en producción, mínimo 16 caracteres)
APP_DB_PASSWORD=cambia-esta-clave-de-la-app

# --- Dominio y HTTPS -----------------------------------------------------
# Local: deja DOMAIN vacío y COMPOSE_PROFILES vacío → http://localhost:8000
# Producción: DOMAIN=rag.tuempresa.com y COMPOSE_PROFILES=https (Caddy obtiene
# el certificado HTTPS automáticamente). Ver docs/produccion.md.
# Si usas tu propio nginx: pon igualmente DOMAIN, deja COMPOSE_PROFILES vacío.
# Con un DOMAIN real: secretos fuertes obligatorios, cookie segura y 2FA del superadmin.
DOMAIN=
COMPOSE_PROFILES=
# En producción: 127.0.0.1 para que la web solo sea accesible a través de HTTPS.
WEB_BIND=0.0.0.0
# URL pública para los enlaces de los correos (vacío = https://DOMAIN o http://localhost:8000).
APP_PUBLIC_URL=

# --- Sesiones y seguridad -------------------------------------------------
# <-- CAMBIAR (en producción, mínimo 32 caracteres). Si lo cambias, todos
# cierran sesión y el 2FA de todos los usuarios deja de funcionar.
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN=12h
# auto = cookie segura cuando la web llega por HTTPS (recomendado). Con DOMAIN real siempre es segura.
COOKIE_SECURE=auto
# Exigir verificación en dos pasos al superadministrador: auto (solo con DOMAIN real), true o false.
REQUIRE_SUPERADMIN_2FA=auto

# --- Primer administrador y organización inicial -------------------------------
# Solo se usan cuando la base de datos está VACÍA (primer arranque). Después no tienen efecto.
# Usuario con el que entras (minúsculas, números, punto, guion). El email es opcional:
# si lo dejas vacío solo podrás entrar con usuario y contraseña (sin recuperación por correo).
# <-- CAMBIAR
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
# <-- CAMBIAR (mín. 10 caracteres)
SEED_ADMIN_PASSWORD=cambia-esta-clave-admin
# Organización «casa» de tu cuenta de superadministrador (también sirve como entorno de pruebas).
SEED_TENANT_NAME="Mi organización"
SEED_TENANT_SLUG=principal

# --- Proveedores de LLM -------------------------------------------------
# Configura AL MENOS UNO (puedes tener varios: el respaldo entre modelos de un plan puede cruzar proveedores).
# Cada modelo de un plan se escribe sin prefijo (= OpenRouter) o con el prefijo del proveedor:
#   google/gemma-4-31b-it:free      OpenRouter (sin prefijo)
#   groq:llama-3.3-70b-versatile    Groq        google:gemini-2.0-flash   Google (Gemini)
#   openai:gpt-4o-mini              OpenAI      deepseek:deepseek-chat    DeepSeek
#   custom:llama3.1:8b              servidor propio (Ollama, vLLM…)
# Los modelos se asignan a cada organización en Organizaciones → Planes.
#
# OpenRouter: una sola clave para casi todos los modelos (Claude, GPT, Gemini, DeepSeek, Qwen, MiniMax…).
# Crea una clave en https://openrouter.ai/keys
# <-- CAMBIAR (o configura otro proveedor de los de abajo)
OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Groq (https://console.groq.com/keys), Google AI Studio (https://aistudio.google.com/apikey),
# OpenAI (https://platform.openai.com/api-keys), DeepSeek (https://platform.deepseek.com/api_keys):
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Servidor propio compatible con OpenAI: dirección con «/v1» al final; la clave es opcional (Ollama no la pide).
# Dentro de Docker, «localhost» es el contenedor: usa host.docker.internal o el nombre del servicio.
LLM_CUSTOM_BASE_URL=
LLM_CUSTOM_API_KEY=
# Proveedor de los modelos escritos sin prefijo (los planes que ya tienes usan OpenRouter).
LLM_DEFAULT_PROVIDER=openrouter
# Modelos del plan «Estándar» en orden de preferencia (el resto son respaldo). Solo se leen la primera vez;
# después se editan en Organizaciones → Planes. Admiten prefijo de proveedor.
# Lista actual de OpenRouter: https://openrouter.ai/models?max_price=0
LLM_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,minimax/minimax-m3.1-flash:free
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
APP_NAME="RAG Project"

# --- Límites -------------------------------------------------------------
# Preguntas al LLM por organización y día (0 = sin límite).
# Valor inicial del plan «Estándar» (después se edita en Organizaciones → Planes).
TENANT_DAILY_QUESTION_LIMIT=200
# Porcentaje del límite diario a partir del cual el chat avisa a los usuarios (1-100).
QUOTA_WARN_PERCENT=80

# --- Embeddings locales (TEI) ------------------------------------------
# ¡OJO! Si cambias el modelo o la dimensión, hay que recrear la tabla de
# trozos y reprocesar todos los documentos (ver docs/operacion.md).
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
EMBEDDING_BATCH_SIZE=16

# --- Ingesta ----------------------------------------------------------
MAX_UPLOAD_MB=50
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
DOCLING_TIMEOUT_SECONDS=900
DOCLING_OCR_LANGS=es,en
DOCLING_WORKERS=1
WORKER_CONCURRENCY=2

# --- Recuperación -----------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=40
# Distancia coseno máxima para resultados semánticos. Depende del modelo; calíbrala con
# POST /api/search (ver docs/operacion.md). Con multilingual-e5-base: relevantes ~0.10-0.18.
RETRIEVAL_MAX_DISTANCE=0.25
FTS_LANGUAGE=spanish
HISTORY_MESSAGES=6

# --- Re-ranking ---------------------------------------------------------
# Modelo local que reordena los resultados (mejora mucho la precisión).
# Para desactivarlo (equipos con poca RAM): deja RERANKER_URL vacío y pon RERANKER_REPLICAS=0.
#RERANKER_URL=
RERANKER_REPLICAS=1
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Fragmentos candidatos que se reordenan y puntuación mínima (0-1) para usarlos.
RERANK_CANDIDATES=20
RERANK_MIN_SCORE=0.02

# --- Caché de respuestas ------------------------------------------------
# Reutiliza respuestas a preguntas repetidas (mismos documentos y permisos)
# sin llamar al LLM. Se invalida al cambiar los documentos o con un 👎.
CACHE_ENABLED=true
CACHE_TTL_HOURS=168
CACHE_MAX_DISTANCE=0.015

# --- Correo (invitaciones y recuperación de contraseña) -----------------
# Vacío = sin correo: los enlaces se muestran al administrador para compartirlos.
# Pruebas locales: COMPOSE_PROFILES=correo-pruebas, SMTP_HOST=mailpit, SMTP_PORT=1025
# y abre http://localhost:8025 para ver los correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="RAG Project <no-reply@tu-dominio.com>"
INVITE_EXPIRES_HOURS=72
RESET_EXPIRES_MINUTES=60

# --- Copias de seguridad y auditoría --------------------------------------
# Copias locales (siempre activas): base de datos + archivos subidos en ./backups.
# Cada copia se verifica restaurándola en una base temporal.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=7
AUDIT_RETENTION_DAYS=365

# Segunda copia FUERA del servidor (opcional, recomendada en producción). Si no pones
# BACKUP_OFFSITE=true, no se hace. Ver docs/produccion.md → «Copias de seguridad».
# Carpeta externa al disco del servidor: disco USB, NAS o carpeta sincronizada con la nube.
# Ejemplos: BACKUP_OFFSITE_DIR=/mnt/nas/rag-backups   o   D:/OneDrive/rag-backups
BACKUP_OFFSITE=false
BACKUP_OFFSITE_DIR=./backups-offsite
# Si la carpeta sale a la nube, CIFRA las copias (guarda esta frase en un gestor de contraseñas:
# sin ella no se pueden restaurar). Vacío = copias sin cifrar.
BACKUP_ENCRYPTION_PASSPHRASE=

# --- Antivirus (opcional) ---------------------------------------------------
# ClamAV analiza cada archivo que se sube y rechaza los infectados. Usa ~2 GB de RAM más y descarga
# sus firmas (~300 MB) al arrancar. Para activarlo: añade «antivirus» a COMPOSE_PROFILES
# (p. ej. COMPOSE_PROFILES=antivirus, o https,antivirus) y pon CLAMAV_HOST=clamav.
# Si lo activas y deja de responder, las subidas se rechazan (mejor no subir que subir sin analizar).
CLAMAV_HOST=
#CLAMAV_PORT=3310
#CLAMAV_TIMEOUT_SECONDS=60
# Tamaño máximo que acepta clamd; debe ser mayor que MAX_UPLOAD_MB.
#CLAMAV_MAX_SIZE=100M

# --- Puertos publicados -----------------------------------------------
# Si al arrancar aparece "ports are not available" o "bind: ... permisos",
# ese puerto está ocupado o reservado por Windows: cambia el número aquí.
# WEB_PORT es el de la interfaz; el resto solo escucha en 127.0.0.1 (depuración).
# Docling no publica ningún puerto: está aislado en una red interna.
WEB_PORT=8000
DB_PORT=15432
EMBEDDINGS_PORT=18080
# Solo con COMPOSE_PROFILES=correo-pruebas (bandeja de Mailpit).
MAILPIT_PORT=8025
