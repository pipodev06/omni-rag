# =====================================================================
# Archivo OPCIONAL. Omni RAG arranca sin él («docker compose up -d»): las contraseñas internas se generan solas en el
# primer arranque y todo lo demás se configura en la web (configuración inicial y Sistema → Configuración).
# Úsalo solo para fijar valores (lo escrito aquí manda y queda bloqueado en la pantalla) o para lo que no está en la
# pantalla (dominio, puertos, recursos, modelo de embeddings…):
#
#   cp .env.example .env
#
# Qué es imprescindible y qué se recomienda: docs/configuracion-inicial.md. No subas el `.env` a git.
#
# Tras editar el .env, aplica los cambios con:  docker compose up -d
# (`restart` NO relee el .env). Ver docs/operacion.md.
# =====================================================================

# --- Base de datos ----------------------------------------------------
# Vacías = las genera el servicio «init» en el primer arranque (volumen «secrets» o ./data/secretos). Guarda esa
# carpeta: no va en las copias de seguridad. Si las escribes aquí, mandan; solo cuentan al CREAR la base de datos y
# cambiarlas después no cambia la contraseña guardada (ver docs/operacion.md → «Cambiar contraseñas»).
# No las borres de un .env que ya las tenía: la base seguiría con las antiguas.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# --- Dominio y HTTPS -----------------------------------------------------
# Local: deja DOMAIN vacío y COMPOSE_PROFILES vacío → http://localhost:8000
# Producción: DOMAIN=rag.tuempresa.com y COMPOSE_PROFILES=https (Caddy obtiene
# el certificado HTTPS automáticamente). Ver docs/produccion.md.
# Si usas tu propio nginx: pon igualmente DOMAIN, deja COMPOSE_PROFILES vacío.
# Con un DOMAIN real: secretos fuertes obligatorios, cookie segura y 2FA del superadmin.
DOMAIN=
COMPOSE_PROFILES=
# En producción: 127.0.0.1 para que la web solo sea accesible a través de HTTPS.
WEB_BIND=0.0.0.0
# URL pública para los enlaces de los correos (vacío = https://DOMAIN o http://localhost:8000).
APP_PUBLIC_URL=

# --- Sesiones y seguridad -------------------------------------------------
# Vacío = lo genera «init» en el primer arranque. Mínimo 32 caracteres si lo escribes. Si cambia, todos cierran sesión,
# el 2FA de todos deja de funcionar y hay que volver a escribir las claves de API guardadas en la pantalla.
JWT_SECRET=
JWT_EXPIRES_IN=12h
# auto = cookie segura cuando la web llega por HTTPS (recomendado). Con DOMAIN real siempre es segura.
COOKIE_SECURE=auto
# Exigir verificación en dos pasos al superadministrador: auto (solo con DOMAIN real), true o false.
REQUIRE_SUPERADMIN_2FA=auto
# Exigir 2FA a TODOS los administradores de organización: false = opcional (por defecto); true = obligatorio.
# El superadministrador se rige por REQUIRE_SUPERADMIN_2FA.
REQUIRE_ADMIN_2FA=false
# Peticiones por minuto y por IP que admite la API de quien NO ha iniciado sesión (0 = sin límite).
# Frena escaneos, fuerza bruta de enlaces e inundación; quien tiene sesión no cuenta.
IP_RATE_LIMIT_PER_MIN=120
# Registros: json (una línea por evento, con requestId; se filtra con jq) o text.
LOG_FORMAT=json

# --- Alertas de monitorización (opcional) ------------------------------------
# El worker revisa cada 5 minutos disco, cola de documentos, copias de seguridad y errores del modelo. Con ALERT_EMAIL
# (uno o varios, separados por comas) y SMTP configurado envía un correo al empezar un problema, un recordatorio cada
# 24 h y otro al resolverse. Vacío = los problemas solo quedan en los registros (docker compose logs worker).
#ALERT_EMAIL=tu@correo.com
#ALERT_DISK_FREE_PERCENT=15
#ALERT_QUEUE_MINUTES=30
#ALERT_BACKUP_HOURS=36
# Un contenedor que pasa de este porcentaje de su tope de RAM genera una alerta («al límite»).
#ALERT_CONTAINER_MEM_PERCENT=90

# --- Métricas de los contenedores (pantalla Sistema, solo superadministrador) -------
# El worker lee el consumo de cada contenedor a través del servicio docker-proxy, que solo responde a las consultas
# de consumo y topes (no puede crear, parar, borrar ni leer archivos). Por defecto http://docker-proxy:2375; déjalo
# vacío para no recoger métricas.
#DOCKER_PROXY_URL=
# Días que se guardan las muestras (una por contenedor y minuto; ~15 MB por contenedor y mes).
#METRICS_RETENTION_DAYS=14
# Socket de Docker que lee el proxy. Cámbialo solo con Docker rootless o Podman (p. ej. /run/user/1000/docker.sock).
#DOCKER_SOCKET=/var/run/docker.sock
# Usuario del proxy. Por defecto root sin capacidades; para uno sin privilegios: 65534:<gid del grupo docker>
# (lo ves con «stat -c %g /var/run/docker.sock»).
#DOCKER_PROXY_USER=0:0

# --- Primer administrador (superadministrador) ---------------------------------
# Opcional. Lo normal es dejarlas vacías y crear el superadministrador en la configuración inicial de la web (pide el
# código de un solo uso que sale en «docker compose logs api»). Sirven para instalaciones automáticas: solo se usan con
# la base de datos VACÍA. El superadministrador vive en la organización interna «Plataforma»: no es un cliente.
# Usuario: minúsculas, números, punto, guion. Email opcional. Contraseña: mín. 10 caracteres.
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Proveedores de LLM -------------------------------------------------
# Configura AL MENOS UNO (puedes tener varios: el respaldo entre modelos de un plan puede cruzar proveedores).
# Cada modelo de un plan se escribe sin prefijo (= OpenRouter) o con el prefijo del proveedor:
#   google/gemma-4-31b-it:free      OpenRouter (sin prefijo)
#   groq:openai/gpt-oss-120b        Groq        google:gemini-3.5-flash   Google (Gemini)
#   openai:gpt-4o-mini              OpenAI      deepseek:deepseek-chat    DeepSeek
#   custom:llama3.1:8b              servidor propio (Ollama, vLLM…)
# Los nombres cambian con frecuencia: para ver los que tienen TUS claves (y cuáles responden de verdad):
#   docker compose exec api node dist/scripts/models.js groq google --probar
# Los modelos se asignan a cada organización en Organizaciones → Planes.
#
# OpenRouter: una sola clave para casi todos los modelos (Claude, GPT, Gemini, DeepSeek, Qwen, MiniMax…).
# Crea una clave en https://openrouter.ai/keys
# <-- CAMBIAR (o configura otro proveedor de los de abajo)
OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Groq (https://console.groq.com/keys), Google AI Studio (https://aistudio.google.com/apikey),
# OpenAI (https://platform.openai.com/api-keys), DeepSeek (https://platform.deepseek.com/api_keys):
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Servidor propio compatible con OpenAI: dirección con «/v1» al final; la clave es opcional (Ollama no la pide).
# Dentro de Docker, «localhost» es el contenedor: usa host.docker.internal o el nombre del servicio.
LLM_CUSTOM_BASE_URL=
LLM_CUSTOM_API_KEY=
# Proveedor de los modelos escritos sin prefijo (los planes que ya tienes usan OpenRouter).
LLM_DEFAULT_PROVIDER=openrouter
# Modelos del plan «Estándar» en orden de preferencia (el resto son respaldo). Solo se leen la primera vez;
# después se editan en Organizaciones → Planes. Admiten prefijo de proveedor.
# Lista actual de OpenRouter: https://openrouter.ai/models?max_price=0
LLM_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,minimax/minimax-m3.1-flash:free
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
APP_NAME="Omni RAG"

# --- Límites -------------------------------------------------------------
# Preguntas al LLM por organización y día (0 = sin límite).
# Valor inicial del plan «Estándar» (después se edita en Organizaciones → Planes).
TENANT_DAILY_QUESTION_LIMIT=200
# Porcentaje del límite diario a partir del cual el chat avisa a los usuarios (1-100).
QUOTA_WARN_PERCENT=80

# --- Embeddings locales (TEI) ------------------------------------------
# ¡OJO! Si cambias el modelo o la dimensión, hay que recrear la tabla de
# trozos y reprocesar todos los documentos (ver docs/operacion.md).
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
EMBEDDING_BATCH_SIZE=16

# --- Búsqueda en internet (opcional, modo híbrido) -------------------------
# Vacío = desactivada. Con un buscador configurado, los planes que lo permitan muestran el interruptor «Internet» en
# el chat. Solo se envía la pregunta al buscador, nunca los documentos. Proveedores:
#   tavily  → clave en https://tavily.com              (WEB_SEARCH_API_KEY)
#   brave   → clave de Brave Search API                 (WEB_SEARCH_API_KEY)
#   searxng → tu propio SearXNG, con el formato json activado en su settings.yml (WEB_SEARCH_URL, sin clave)
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_URL=
# Resultados de internet que se le dan al modelo en cada pregunta (1-10).
#WEB_SEARCH_MAX_RESULTS=5

# --- Ingesta ----------------------------------------------------------
MAX_UPLOAD_MB=50
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
DOCLING_TIMEOUT_SECONDS=900
DOCLING_OCR_LANGS=es,en
# OCR de imágenes y escaneos (true/false). Desactivarlo acelera los PDF digitales, pero no lee los escaneados.
DOCLING_DO_OCR=true
# Detección de tablas: accurate (más fiel) o fast (más rápida, algo menos precisa en tablas complejas).
DOCLING_TABLE_MODE=accurate
DOCLING_WORKERS=1
WORKER_CONCURRENCY=2

# --- Reparto de recursos (lo calcula deploy/autotune.sh) -------------------
# Límites de CPU y memoria de los servicios pesados, para no ahogar a otros contenedores del servidor. Lo normal es no
# escribirlos a mano: «bash deploy/autotune.sh --aplicar» los calcula según el hardware (docs/operacion.md → Autoajuste).
# 0 / 1024 = sin límite y peso normal. Se aplican con «docker compose up -d».
#RERANKER_CPUS=0
#RERANKER_CPU_SHARES=1024
#RERANKER_MEM_LIMIT=0
#EMBEDDINGS_CPUS=0
#EMBEDDINGS_CPU_SHARES=1024
#EMBEDDINGS_MEM_LIMIT=0
#DOCLING_CPUS=0
#DOCLING_CPU_SHARES=1024
#DOCLING_MEM_LIMIT=0
#DOCLING_OOM_SCORE_ADJ=0
#WORKER_CPU_SHARES=1024

# --- Red ---------------------------------------------------------------
# DNS de los contenedores que salen a internet (API, worker, modelos, antivirus, copias). Por defecto Cloudflare y Google,
# por IPv4, para no depender del DNS del servidor (a veces solo IPv6). En una red con DNS propio (nombres internos de un
# SMTP o de SearXNG, por ejemplo), pon aquí los de tu red. Se aplican con «docker compose up -d».
#DNS_PRIMARY=1.1.1.1
#DNS_SECONDARY=8.8.8.8

# --- Recuperación -----------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=40
# Distancia coseno máxima para resultados semánticos. Depende del modelo; calíbrala con
# POST /api/search (ver docs/operacion.md). Con multilingual-e5-base: relevantes ~0.10-0.18.
RETRIEVAL_MAX_DISTANCE=0.25
FTS_LANGUAGE=spanish
HISTORY_MESSAGES=6

# --- Re-ranking ---------------------------------------------------------
# Modelo local que reordena los resultados (mejora mucho la precisión).
# Para desactivarlo (equipos con poca RAM): deja RERANKER_URL vacío y pon RERANKER_REPLICAS=0.
#RERANKER_URL=
RERANKER_REPLICAS=1
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Fragmentos candidatos que se reordenan y puntuación mínima (0-1) para usarlos.
RERANK_CANDIDATES=20
RERANK_MIN_SCORE=0.02
# Recortar cada candidato a N caracteres antes de re-rankear: más rápido (900 ≈ -35 % de tiempo, 600 ≈ -55 %) pero cambia
# qué fragmentos salen primero (ver docs/operacion.md → «Prueba de carga»). 0 = texto completo (recomendado).
#RERANK_MAX_CHARS=0
# Re-rankings simultáneos (el resto espera su turno). 1 = en fila: con varias preguntas a la vez, la primera termina antes y
# ninguna agota el tiempo de espera (con 6 a la vez, 4 se quedaban sin re-ranking). Súbelo si el servidor de re-ranking es muy potente.
#RERANK_PARALLEL=1

# --- Caché de respuestas ------------------------------------------------
# Reutiliza respuestas a preguntas repetidas (mismos documentos y permisos)
# sin llamar al LLM. Se invalida al cambiar los documentos o con un 👎.
CACHE_ENABLED=true
CACHE_TTL_HOURS=168
CACHE_MAX_DISTANCE=0.015

# --- Correo (invitaciones y recuperación de contraseña) -----------------
# Vacío = sin correo: los enlaces se muestran al administrador para compartirlos.
# Pruebas locales: COMPOSE_PROFILES=correo-pruebas, SMTP_HOST=mailpit, SMTP_PORT=1025
# y abre http://localhost:8025 para ver los correos.
# Para probar tu SMTP: docker compose exec api node dist/scripts/test-email.js tu@correo.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Omni RAG <no-reply@tu-dominio.com>"
INVITE_EXPIRES_HOURS=72
RESET_EXPIRES_MINUTES=60

# --- Copias de seguridad y auditoría --------------------------------------
# Copias locales (siempre activas): base de datos + archivos subidos en ./backups.
# Cada copia se verifica restaurándola en una base temporal.
# Los ajustes de copias y de Backblaze (BACKUP_INTERVAL_HOURS, BACKUP_KEEP_DAYS, BACKUP_AT, BACKUP_TZ, BACKUP_UPLOADS_TGZ,
# BACKUP_OFFSITE y todas las B2_*) también se pueden cambiar en Sistema → Copias, sin reiniciar. Ojo: lo que escribas
# aquí MANDA sobre la pantalla y queda bloqueado allí; por eso van comentados. Descoméntalos solo si quieres fijarlos.
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7
# Hora fija en vez de cada N horas (formato HH:MM, 24 h). Vacío = cada BACKUP_INTERVAL_HOURS desde que arranca el
# contenedor. Con hora fija, al arrancar solo se copia si la última tiene más de 24 h. La hora es la de BACKUP_TZ
# (por defecto Lima, UTC-5).
#BACKUP_AT=03:00
#BACKUP_TZ="<-05>5"
# Copia diaria de los archivos subidos en un .tgz (por defecto sí). Con muchos GB ponla en false y usa
# B2_SYNC_UPLOADS=true: sube los archivos de forma incremental (solo lo nuevo) y cifrados a Backblaze.
#BACKUP_UPLOADS_TGZ=true
AUDIT_RETENTION_DAYS=365
# Papelera: días que un documento borrado se conserva (y se puede restaurar) antes de eliminarse del todo. 0 = sin papelera.
TRASH_RETENTION_DAYS=30

# Segunda copia FUERA del servidor (opcional, recomendada en producción). Si no pones
# BACKUP_OFFSITE=true, no se hace. Ver docs/produccion.md → «Copias de seguridad».
# Carpeta externa al disco del servidor: disco USB, NAS o carpeta sincronizada con la nube.
# Ejemplos: BACKUP_OFFSITE_DIR=/mnt/nas/rag-backups   o   D:/OneDrive/rag-backups
#BACKUP_OFFSITE=false
BACKUP_OFFSITE_DIR=./backups-offsite
# Discos o carpetas entre los que se puede elegir el destino de la copia externa desde Sistema → Copias, y mover allí
# las copias. Es una carpeta DEL SERVIDOR que contiene los discos (cada USB o NAS, una subcarpeta). Vacío = no se puede
# cambiar el destino desde la pantalla. Ejemplos: BACKUP_TARGETS_DIR=/mnt   o   BACKUP_TARGETS_DIR=D:/
# Tras conectar o desconectar un disco: docker compose restart backup. Ver docs/produccion.md.
#BACKUP_TARGETS_DIR=/mnt
# Subcarpeta de BACKUP_TARGETS_DIR donde se guarda la copia externa. La fija la pantalla al cambiar el destino; ponerla
# aquí la bloquea. Vacío = la carpeta BACKUP_OFFSITE_DIR de arriba.
#BACKUP_DESTINATION=
# Si la carpeta sale a la nube, CIFRA las copias (guarda esta frase en un gestor de contraseñas:
# sin ella no se pueden restaurar). Vacío = copias sin cifrar.
BACKUP_ENCRYPTION_PASSPHRASE=

# Subir esa carpeta a Backblaze B2 (opcional, recomendado): el servicio backup-b2 siempre está en marcha y espera
# hasta tener bucket y claves. Exige
# BACKUP_OFFSITE=true y la frase de cifrado (solo se suben archivos .enc). Pasos: docs/produccion.md.
# Las claves y los horarios de B2 se pueden escribir aquí (y quedan bloqueados en la pantalla) o dejarlos vacíos y
# guardarlos en Sistema → Copias; el servicio los toma solo en un minuto.
# B2_KEY_ID y B2_APPLICATION_KEY: una Application Key limitada a ese bucket (no la Master Key).
#B2_KEY_ID=
#B2_APPLICATION_KEY=
#B2_BUCKET=
#B2_PATH=omni-rag
#B2_INTERVAL_HOURS=6
# Una subida diaria a esta hora (HH:MM, hora de BACKUP_TZ), después de BACKUP_AT. Vacío = cada B2_INTERVAL_HOURS.
#B2_AT=04:00
# Subir también los archivos subidos, incremental y cifrados (nombres y contenido). Lo borrado en la aplicación se
# conserva B2_KEEP_DAYS días en archive/. Necesita BACKUP_ENCRYPTION_PASSPHRASE.
#B2_SYNC_UPLOADS=true
#B2_KEEP_DAYS=30

# --- Antivirus (opcional) ---------------------------------------------------
# ClamAV analiza cada archivo que se sube y rechaza los infectados. Usa ~2 GB de RAM más y descarga
# sus firmas (~300 MB) al arrancar. Para activarlo: añade «antivirus» a COMPOSE_PROFILES
# (p. ej. COMPOSE_PROFILES=antivirus, o https,antivirus) y pon CLAMAV_HOST=clamav.
# Si lo activas y deja de responder, las subidas se rechazan (mejor no subir que subir sin analizar).
CLAMAV_HOST=
#CLAMAV_PORT=3310
#CLAMAV_TIMEOUT_SECONDS=60
# Tamaño máximo que acepta clamd; debe ser mayor que MAX_UPLOAD_MB.
#CLAMAV_MAX_SIZE=100M

# --- Puertos publicados -----------------------------------------------
# Si al arrancar aparece "ports are not available" o "bind: ... permisos",
# ese puerto está ocupado o reservado por Windows: cambia el número aquí.
# WEB_PORT es el de la interfaz; el resto solo escucha en 127.0.0.1 (depuración).
# Docling no publica ningún puerto: está aislado en una red interna.
WEB_PORT=8000
DB_PORT=15432
EMBEDDINGS_PORT=18080
# Solo con COMPOSE_PROFILES=correo-pruebas (bandeja de Mailpit).
MAILPIT_PORT=8025

# --- Versión de las imágenes ------------------------------------------
# Las imágenes de la API y la web se descargan de GitHub (ghcr.io/pipodev06/omni-rag-api y
# omni-rag-web). Vacío = latest (lo último de main). Para fijar una versión: OMNI_RAG_VERSION=1.2.0.
#OMNI_RAG_VERSION=
