# =====================================================================
# Copia este archivo a `.env` y completa los valores marcados con  <-- CAMBIAR
# Genera secretos aleatorios con:  openssl rand -base64 48
# =====================================================================

# --- Base de datos ----------------------------------------------------
# <-- CAMBIAR
POSTGRES_PASSWORD=cambia-esta-clave-del-owner
# <-- CAMBIAR (usuario rag_app, sujeto a RLS)
APP_DB_PASSWORD=cambia-esta-clave-de-la-app

# --- Sesiones ---------------------------------------------------------
# <-- CAMBIAR
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN=12h
# Pon "true" cuando sirvas la web por HTTPS.
COOKIE_SECURE=false

# --- Primer administrador (se crea solo si la base de datos está vacía) ---
# <-- CAMBIAR
SEED_ADMIN_EMAIL=admin@example.com
# <-- CAMBIAR (mín. 10 caracteres)
SEED_ADMIN_PASSWORD=cambia-esta-clave-admin
SEED_TENANT_NAME="Mi organización"
SEED_TENANT_SLUG=principal

# --- OpenRouter (LLM) -------------------------------------------------
# Crea una clave en https://openrouter.ai/keys
# <-- CAMBIAR
OPENROUTER_API_KEY=
# Modelos gratuitos en orden de preferencia (el resto son respaldo).
# Lista actual: https://openrouter.ai/models?max_price=0
LLM_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,minimax/minimax-m3.1-flash:free
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
APP_PUBLIC_URL=http://localhost:8000
APP_NAME="RAG Project"

# --- Embeddings locales (TEI) ------------------------------------------
# ¡OJO! Si cambias el modelo o la dimensión, hay que recrear la tabla de
# trozos y reprocesar todos los documentos (ver docs/operacion.md).
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
EMBEDDING_BATCH_SIZE=16

# --- Ingesta ----------------------------------------------------------
MAX_UPLOAD_MB=50
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
DOCLING_TIMEOUT_SECONDS=900
DOCLING_OCR_LANGS=es,en
DOCLING_WORKERS=2
WORKER_CONCURRENCY=2

# --- Recuperación -----------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=40
# Distancia coseno máxima para resultados semánticos. Depende del modelo; calíbrala con
# POST /api/search (ver docs/operacion.md). Con multilingual-e5-base: relevantes ~0.10-0.18.
RETRIEVAL_MAX_DISTANCE=0.25
FTS_LANGUAGE=spanish
HISTORY_MESSAGES=6

# --- Re-ranking ---------------------------------------------------------
# Modelo local que reordena los resultados (mejora mucho la precisión).
# Para desactivarlo (equipos con poca RAM): deja RERANKER_URL vacío y pon RERANKER_REPLICAS=0.
#RERANKER_URL=
RERANKER_REPLICAS=1
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Fragmentos candidatos que se reordenan y puntuación mínima (0-1) para usarlos.
RERANK_CANDIDATES=20
RERANK_MIN_SCORE=0.02

# --- Caché de respuestas ------------------------------------------------
# Reutiliza respuestas a preguntas repetidas (mismos documentos y permisos)
# sin llamar al LLM. Se invalida al cambiar los documentos o con un 👎.
CACHE_ENABLED=true
CACHE_TTL_HOURS=168
CACHE_MAX_DISTANCE=0.015

# --- Límites ----------------------------------------------------------
# Preguntas al LLM por organización y día (0 = sin límite).
# Se puede ajustar por organización desde el panel de plataforma.
TENANT_DAILY_QUESTION_LIMIT=200

# --- Puertos publicados -----------------------------------------------
# Si al arrancar aparece "ports are not available" o "bind: ... permisos",
# ese puerto está ocupado o reservado por Windows: cambia el número aquí.
# WEB_PORT es el de la interfaz; el resto solo escucha en 127.0.0.1 (depuración).
WEB_PORT=8000
DB_PORT=15432
EMBEDDINGS_PORT=18080
DOCLING_PORT=15001
